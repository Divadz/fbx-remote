# Fins de ligne normalisées en LF dans le dépôt, quel que soit l'OS de travail.
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.bat text eol=crlf

# Script Unix du wrapper Gradle
gradlew text eol=lf

# Fichiers binaires
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.jar binary
*.apk binary
